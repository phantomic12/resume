---
// Yoav Tirosh — Resume
// Dark premium single-page. No emojis, no cookie-cutter gradients.
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Yoav Tirosh — Resume</title>
  <meta name="description" content="IT Support Technician — System Administration, Hardware Deployment, Linux & Automation" />

  <link rel="preconnect" href="https://rsms.me/" />
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

  <style is:global>
    /* ── Reset & Tokens ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0f172a;
      --bg-spot: rgba(30, 64, 175, 0.12);
      --text-primary: #e2e8f0;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --accent: #f59e0b;
      --accent-dim: rgba(245, 158, 11, 0.12);
      --border: rgba(148, 163, 184, 0.08);
      --hover-bg: rgba(148, 163, 184, 0.04);
      --radius: 0.375rem;
    }

    html { font-size: 16px; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';
      line-height: 1.6;
      color: var(--text-primary);
      background: var(--bg);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    ::selection { background: rgba(245, 158, 11, 0.3); color: #fff; }

    /* ── Background Spotlight ── */
    .spotlight {
      pointer-events: none;
      position: fixed;
      inset: 0;
      z-index: 0;
      background: radial-gradient(
        600px circle at 50% 50%,
        var(--bg-spot),
        transparent 70%
      );
      transition: opacity 0.6s;
    }

    /* ── Layout ── */
    .wrapper {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    @media (min-width: 900px) {
      .resume-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }
      .sidebar {
        position: sticky;
        top: 0;
        max-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 6rem 0;
      }
      .content { padding: 6rem 0; }
    }

    /* ── Sidebar ── */
    .sidebar {
      padding-top: 2.5rem;
      padding-bottom: 1.5rem;
    }
    .sidebar h1 {
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      color: var(--text-primary);
      line-height: 1.1;
    }
    .sidebar .role {
      margin-top: 0.75rem;
      font-size: 1.15rem;
      font-weight: 500;
      color: var(--text-secondary);
    }
    .sidebar .summary-text {
      margin-top: 1.25rem;
      max-width: 28rem;
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.7;
    }

    /* ── Nav (desktop only) ── */
    .sidebar-nav {
      display: none;
      margin-top: 3rem;
    }
    @media (min-width: 900px) {
      .sidebar-nav { display: block; }
    }
    .sidebar-nav a {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      transition: color 0.2s;
    }
    .sidebar-nav a:hover,
    .sidebar-nav a.active { color: var(--text-primary); }
    .sidebar-nav a .nav-line {
      display: block;
      width: 2rem;
      height: 1px;
      background: var(--text-muted);
      transition: width 0.2s, background 0.2s;
    }
    .sidebar-nav a:hover .nav-line,
    .sidebar-nav a.active .nav-line {
      width: 4rem;
      background: var(--text-primary);
    }

    /* ── Contact ── */
    .contact-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      margin-top: 2rem;
    }
    .contact-links a,
    .contact-links span {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: color 0.2s;
    }
    .contact-links a:hover { color: var(--accent); }
    .contact-links .sep { color: var(--border); user-select: none; }

    .contact-links svg { width: 14px; height: 14px; opacity: 0.6; }

    /* ── Sections ── */
    .section {
      margin-bottom: 4rem;
      scroll-margin-top: 2rem;
    }
    .section-title {
      display: none;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }
    @media (min-width: 900px) {
      .section-title { display: block; }
    }
    /* Mobile section label */
    .section-label-mobile {
      display: block;
      position: sticky;
      top: 0;
      z-index: 10;
      padding: 1rem 0;
      margin-bottom: 1rem;
      background: rgba(15, 23, 42, 0.8);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-muted);
    }
    @media (min-width: 900px) {
      .section-label-mobile { display: none; }
    }

    /* ── Experience Cards ── */
    .exp-group { list-style: none; }
    .exp-item {
      position: relative;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 1.25rem 1rem 1.25rem 1.75rem;
      margin: 0 -1rem;
      border-radius: var(--radius);
      transition: background 0.2s, box-shadow 0.2s;
      cursor: default;
    }
    @media (min-width: 640px) {
      .exp-item { grid-template-columns: 140px 1fr; gap: 1.5rem; }
    }

    /* Group hover: dim all, highlight hovered */
    .exp-group:hover .exp-item { opacity: 0.5; }
    .exp-group .exp-item:hover {
      opacity: 1 !important;
      background: var(--hover-bg);
      box-shadow: inset 0 1px 0 0 var(--border);
    }

    .exp-dates {
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--text-muted);
      white-space: nowrap;
      padding-top: 0.15rem;
    }
    .exp-body {}
    .exp-body h3 {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 0.15rem;
    }
    .exp-body h3 a {
      color: inherit;
      text-decoration: none;
    }
    .exp-body .org {
      font-size: 0.88rem;
      color: var(--text-secondary);
      font-weight: 500;
    }
    .exp-body .role-title {
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--accent);
      margin: 0.3rem 0 0.5rem;
      padding-left: 0.75rem;
    }
    .exp-body p {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.65;
    }
    .exp-body ul {
      list-style: none;
      padding: 0;
      margin-top: 0.4rem;
    }
    .exp-body ul li {
      position: relative;
      padding-left: 1rem;
      font-size: 0.85rem;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 0.2rem;
    }
    .exp-body ul li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.6em;
      width: 5px;
      height: 5px;
      background: var(--text-muted);
      border-radius: 50%;
      opacity: 0.5;
    }

    /* ── Education (same card style) ── */
    .edu-item {
      padding: 1.25rem 1rem 1.25rem 1.75rem;
      margin: 0 -1rem;
      border-radius: var(--radius);
    }
    .edu-item h3 { font-size: 0.95rem; font-weight: 600; color: var(--text-primary); }
    .edu-item .school { font-size: 0.85rem; color: var(--accent); font-weight: 600; margin: 0.15rem 0; padding-left: 0.75rem; }
    .edu-item .edu-dates { font-size: 0.78rem; color: var(--text-muted); padding-left: 0.75rem; }

    /* ── Skills ── */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1.5rem;
      padding-left: 0.75rem;
    }
    .skill-block h4 {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 0.6rem;
    }
    .skill-block .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      padding-left: 0.75rem;
    }
    .skill-block .tag {
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--accent);
      background: var(--accent-dim);
      padding: 0.25rem 0.7rem;
      border-radius: 99px;
      transition: background 0.2s;
    }
    .skill-block .tag:hover { background: rgba(245, 158, 11, 0.2); }

    /* ── Footer ── */
    .site-footer {
      margin-top: 4rem;
      padding: 2rem 0;
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .site-footer a { color: var(--text-secondary); text-decoration: none; }
    .site-footer a:hover { color: var(--accent); }

    /* ── Animations ── */
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .reveal {
      opacity: 0;
      animation: fade-up 0.5s ease-out forwards;
    }
    .reveal-delay-1 { animation-delay: 0.1s; }
    .reveal-delay-2 { animation-delay: 0.2s; }
    .reveal-delay-3 { animation-delay: 0.3s; }
    .reveal-delay-4 { animation-delay: 0.4s; }
    .reveal-delay-5 { animation-delay: 0.5s; }

    /* ── Link styles ── */
    a.inline-link {
      color: var(--text-primary);
      text-decoration: none;
      background-image: linear-gradient(var(--accent), var(--accent));
      background-size: 0% 1px;
      background-position: 0% 100%;
      background-repeat: no-repeat;
      transition: background-size 0.3s;
    }
    a.inline-link:hover { background-size: 100% 1px; }

    /* ── Print ── */
    @media print {
      :root { --bg: #fff; --text-primary: #111; --text-secondary: #333; --text-muted: #555; --accent: #000; }
      body { font-size: 10pt; }
      .spotlight, .sidebar-nav, .section-label-mobile, .site-footer { display: none !important; }
      .wrapper { max-width: 100%; padding: 0; }
      .resume-grid { display: block; }
      .sidebar { position: static; max-height: none; padding: 0 0 1rem; text-align: left; }
      .content { padding: 0; }
      .sidebar h1 { font-size: 16pt; }
      .exp-item { opacity: 1 !important; break-inside: avoid; margin: 0; padding: 0.4rem 0; }
      .exp-group:hover .exp-item { opacity: 1 !important; }
      .skill-block .tag { background: #eee; color: #000; border: 1px solid #ccc; }
      .section-title { display: block; color: #000; }
      .reveal { opacity: 1; animation: none; }
    }
  </style>
</head>

<body>
  <div class="spotlight" aria-hidden="true"></div>

  <div class="wrapper">
    <div class="resume-grid">

      <!-- ═══════════ SIDEBAR ═══════════ -->
      <aside class="sidebar">
        <div class="reveal">
          <h1>Yoav Tirosh</h1>
          <p class="role">IT Support Technician</p>
          <p class="summary-text">
            Hands-on experience in hardware deployment, system administration,
            and infrastructure. Linux, scripting &amp; automation, and end-user
            support. Pursuing A.S. in Computer Science &amp; Information Security
            at CUNY Queensborough.
          </p>
        </div>

        <!-- Contact -->
        <div class="contact-links reveal reveal-delay-1">
          <a href="mailto:yoavtirosh54@gmail.com">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13 2 4"/></svg>
            yoavtirosh54@gmail.com
          </a>
          <span class="sep">—</span>
          <a href="https://github.com/phantomic12" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </a>
          <span class="sep">—</span>
          <span>Jamaica, NY</span>
        </div>

        <!-- Nav (desktop) -->
        <nav class="sidebar-nav reveal reveal-delay-2">
          <a href="#experience"><span class="nav-line"></span>Experience</a>
          <a href="#education"><span class="nav-line"></span>Education</a>
          <a href="#skills"><span class="nav-line"></span>Skills</a>
        </nav>
      </aside>

      <!-- ═══════════ CONTENT ═══════════ -->
      <main class="content">

        <!-- Experience -->
        <section id="experience" class="section">
          <div class="section-label-mobile">Experience</div>
          <div class="section-title reveal">Experience</div>

          <ul class="exp-group" role="list">
            <li class="exp-item reveal reveal-delay-1">
              <div class="exp-dates">2021 – Present</div>
              <div class="exp-body">
                <h3>S.I.S Consultants Incorporated</h3>
                <p class="role-title">IT Technician</p>
                <ul>
                  <li>Deploy applications and hardware across multiple corporate client sites</li>
                  <li>Diagnose, repair, and maintain on-site client computers and cloud services</li>
                  <li>Configure and manage Windows Server Update Services (WSUS)</li>
                </ul>
              </div>
            </li>

            <li class="exp-item reveal reveal-delay-2">
              <div class="exp-dates">2021 – 2024</div>
              <div class="exp-body">
                <h3>The Sohotel <span class="org">· Bowery, NY</span></h3>
                <p class="role-title">IT &amp; Operations Support</p>
                <ul>
                  <li>Administered server and network infrastructure for hotel operations</li>
                  <li>Configured and maintained email server for all hotel staff</li>
                  <li>Managed backup systems across deployed workstations</li>
                  <li>Performed data entry and handled customer inquiries</li>
                </ul>
              </div>
            </li>

            <li class="exp-item reveal reveal-delay-3">
              <div class="exp-dates">2019 – 2020</div>
              <div class="exp-body">
                <h3>Skadden, Arps, Slate, Meagher &amp; Flom LLP</h3>
                <p class="role-title">Office Services Assistant</p>
                <ul>
                  <li>Coordinated mail delivery and package distribution across departments</li>
                  <li>Gained exposure to enterprise IT operations in a premier law firm environment</li>
                </ul>
              </div>
            </li>

            <li class="exp-item reveal reveal-delay-4">
              <div class="exp-dates">2018 – 2019</div>
              <div class="exp-body">
                <h3>Barnes &amp; Noble</h3>
                <p class="role-title">Inventory Associate</p>
                <ul>
                  <li>Managed inventory and organized publication stock</li>
                  <li>Restocked shelves and maintained merchandising standards</li>
                </ul>
              </div>
            </li>
          </ul>
        </section>

        <!-- Education -->
        <section id="education" class="section">
          <div class="section-label-mobile">Education</div>
          <div class="section-title reveal">Education</div>
          <div class="edu-item reveal reveal-delay-1">
            <h3>Computer Science &amp; Information Security, A.S.</h3>
            <p class="school">Queensborough Community College, CUNY</p>
            <p class="edu-dates">August 2023 – Present</p>
          </div>
        </section>

        <!-- Skills -->
        <section id="skills" class="section">
          <div class="section-label-mobile">Skills</div>
          <div class="section-title reveal">Skills</div>
          <div class="skills-grid">
            <div class="skill-block reveal reveal-delay-1">
              <h4>Languages</h4>
              <div class="tag-row">
                <span class="tag">Python</span>
                <span class="tag">C++</span>
                <span class="tag">YAML</span>
                <span class="tag">HTML</span>
                <span class="tag">CSS</span>
                <span class="tag">JSON</span>
              </div>
            </div>
            <div class="skill-block reveal reveal-delay-2">
              <h4>Technical</h4>
              <div class="tag-row">
                <span class="tag">Git</span>
                <span class="tag">GitHub</span>
                <span class="tag">Linux</span>
                <span class="tag">Networking</span>
                <span class="tag">Docker</span>
                <span class="tag">Virtualization</span>
                <span class="tag">PC Imaging</span>
                <span class="tag">PC Building</span>
                <span class="tag">VS Code</span>
              </div>
            </div>
            <div class="skill-block reveal reveal-delay-3">
              <h4>Productivity</h4>
              <div class="tag-row">
                <span class="tag">Microsoft 365</span>
                <span class="tag">Google Workspace</span>
              </div>
            </div>
          </div>
        </section>

        <footer class="site-footer">
          <p>Built with <a href="https://astro.build" class="inline-link">Astro</a> · Deployed on <a href="https://pages.github.com" class="inline-link">GitHub Pages</a> · <a href="https://github.com/phantomic12/resume" class="inline-link">Source</a></p>
        </footer>

      </main>
    </div>
  </div>

  <!-- ── Spotlight follows mouse ── -->
  <script>
    const spot = document.querySelector('.spotlight');
    document.addEventListener('mousemove', (e) => {
      spot.style.background = `radial-gradient(600px circle at ${e.clientX}px ${e.clientY}px, var(--bg-spot), transparent 70%)`;
    });

    // Active nav highlight
    const sections = document.querySelectorAll('.section');
    const navLinks = document.querySelectorAll('.sidebar-nav a');
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          navLinks.forEach(link => link.classList.remove('active'));
          const id = entry.target.id;
          const active = document.querySelector(`.sidebar-nav a[href="#${id}"]`);
          if (active) active.classList.add('active');
        }
      });
    }, { threshold: 0.4 });
    sections.forEach(s => obs.observe(s));
  </script>
</body>
</html>
